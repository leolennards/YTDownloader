<?xml version="1.0" encoding="utf-8"?>
<!-- long press the app icon on the home screen to jump straight to these -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_download"
        android:shortcutId="new_download"
        android:shortcutLongLabel="@string/shortcut_download_long"
        android:shortcutShortLabel="@string/shortcut_download">
        <intent
            android:action="com.leolennards.ytdownloader.NEW_DOWNLOAD"
            android:targetClass="com.leolennards.ytdownloader.MainActivity"
            android:targetPackage="com.leolennards.ytdownloader" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_library"
        android:shortcutId="library"
        android:shortcutLongLabel="@string/shortcut_library_long"
        android:shortcutShortLabel="@string/shortcut_library">
        <intent
            android:action="com.leolennards.ytdownloader.OPEN_LIBRARY"
            android:targetClass="com.leolennards.ytdownloader.MainActivity"
            android:targetPackage="com.leolennards.ytdownloader" />
    </shortcut>
</shortcuts>
